# docker compose 用の設定。使う場合は .env にコピーして編集する。

# PostgreSQL のパスワード
POSTGRES_PASSWORD=change-me

# 公開ポート (他プロジェクトと衝突する場合に変更する)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ブラウザから見た backend の URL (フロントエンドのビルド時に埋め込まれる)
NEXT_PUBLIC_API_BASE=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- 認証 (複数人で使う場合は有効にする) ---
DSC_AUTH_ENABLED=false
# 有効にする場合は必須。推測されない長いランダム文字列を設定する。
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DSC_SECRET_KEY=
# 初回起動時だけ作られる管理者。未設定なら画面から作成できる。
DSC_BOOTSTRAP_ADMIN_USERNAME=
DSC_BOOTSTRAP_ADMIN_PASSWORD=

# --- AI推奨事項を Claude API で生成する場合のみ ---
ANTHROPIC_API_KEY=
