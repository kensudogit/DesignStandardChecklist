# docker compose 用の設定。使う場合は .env にコピーして編集する。

# PostgreSQL のパスワード
POSTGRES_PASSWORD=change-me

# 公開ポート (他プロジェクトと衝突する場合に変更する)
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ブラウザから見た backend の URL (フロントエンドのビルド時に埋め込まれる)
NEXT_PUBLIC_API_BASE=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# --- 認証 (複数人で使う場合は有効にする) ---
DSC_AUTH_ENABLED=false
# 有効にする場合は必須。推測されない長いランダム文字列を設定する。
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DSC_SECRET_KEY=
# 初回起動時だけ作られる管理者。未設定なら画面から作成できる。
DSC_BOOTSTRAP_ADMIN_USERNAME=
DSC_BOOTSTRAP_ADMIN_PASSWORD=

# --- Claude API を使う場合のみ ---
ANTHROPIC_API_KEY=

# 並列表現の分解を Claude に手伝わせる (STEP 7 補助)。
# 既定は false で、変換は完全にルールベース。true にしても、Claude が返せるのは
# 「原文のどこで切るか」だけで、原文に無い語がチェック項目に入ることはない。
# ANTHROPIC_API_KEY が無ければ true でもルールベースのまま動く。
DSC_LLM_SPLIT_ENABLED=false

# 規定か記述例かの判定を Claude に手伝わせる (STEP 5 補助)。
# 対象は、表の行のうちルールベースが規範表現を見つけられなかったものだけ。
# 「要件IDを必ず紐付ける」のような体言止めの規定を拾えるようになる。
# 既定は false。true にしても Claude が答えるのは可否・規範レベル・原文中の根拠だけで、
# チェック項目の文言は従来どおり原文から組み立てる。根拠が原文に無ければ判定を捨てる。
# ANTHROPIC_API_KEY が無ければ true でもルールベースのまま動く。
DSC_LLM_CLASSIFY_ENABLED=false
