# SQLite database file (relative to backend/)
DSC_DATABASE_URL=sqlite:///./storage/dsc.db
# Uploaded source documents
DSC_STORAGE_DIR=./storage/uploads
# CORS origin of the Next.js frontend
DSC_CORS_ORIGINS=http://localhost:3000
# Dev convenience: allow any localhost port. Set to an empty value in production.
DSC_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+
