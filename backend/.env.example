# SQLite database file (relative to backend/)
DSC_DATABASE_URL=sqlite:///./storage/dsc.db
# PostgreSQL を使う場合 (複数人で同時にレビュー記入するとき推奨)
# DSC_DATABASE_URL=postgresql+psycopg://dsc:password@localhost:5432/dsc
DSC_DB_POOL_SIZE=5
DSC_DB_MAX_OVERFLOW=10

# Uploaded source documents
DSC_STORAGE_DIR=./storage/uploads

# CORS origin of the Next.js frontend
DSC_CORS_ORIGINS=http://localhost:3000
# Dev convenience: allow any localhost port. Set to an empty value in production.
DSC_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# --- 認証 (既定は無効。複数人で使う場合に有効化する) ---
DSC_AUTH_ENABLED=false
# 有効にする場合は必須。推測されない長いランダム文字列を設定する。
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DSC_SECRET_KEY=
# セッションの有効期間 (秒)。既定12時間。
DSC_SESSION_TTL_SECONDS=43200
# 初回起動時だけ作られる管理者。未設定なら画面から作成できる。
DSC_BOOTSTRAP_ADMIN_USERNAME=
DSC_BOOTSTRAP_ADMIN_PASSWORD=
